# Desenvolvimento: o browser fala direto com a API local.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Produção (Vercel): browser same-origin via rewrite.
# NEXT_PUBLIC_API_URL=/api
# API_PROXY_TARGET=https://<railway-api-origin>
# API_PROXY_TARGET é server-side. Não use NEXT_PUBLIC_API_PROXY_TARGET.
