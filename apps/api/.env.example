# Desenvolvimento local. Nunca reutilize estas credenciais em produção.
NODE_ENV=development
PORT=3001
# HOST é opcional. Em produção a API escuta em 0.0.0.0 se HOST não for definido.
# TRUST_PROXY_HOPS permanece 0 até a topologia real do Railway ser validada. Não use true.
TRUST_PROXY_HOPS=0
# Diagnóstico temporário de latência. true escreve logs [PERF] (rota, operação, ms, requestId). Padrão: desligado.
# PERF_LOGGING=true

# PostgreSQL Docker deste projeto (localhost:5433). Não use a instância Windows em 5432.
DATABASE_URL=postgresql://central:central@localhost:5433/central_academica
# Obrigatório só em testes locais. Produção não usa TEST_DATABASE_URL.
TEST_DATABASE_URL=postgresql://central:central@localhost:5433/central_academica_test
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=dev-session-secret-central-academica-fiap
# Sessões: cookie HttpOnly + SameSite=Lax (+ Secure em produção), Max-Age 24h.
# TTL no PostgreSQL também é 24h absolutas a partir do último store.set (login/regenerate/save).
# GET autenticado não renova cookie nem expire no banco (disableTouch, rolling=false).

# --- Produção (não preencher com valores reais neste arquivo) ---
# NODE_ENV=production
# PORT=                      # fornecido pela plataforma de hosting
# DATABASE_URL=              # PostgreSQL hospedado (runtime da API)
# MIGRATION_DATABASE_URL=    # somente npm run db:migrate:prod; a API não lê esta variável na subida
# DATABASE_SSL_CA=           # PEM da CA do Postgres hospedado (opcional, server-side). Use a CA oficial do provedor; não desliga a verificação TLS.
# SESSION_SECRET=            # único, alta entropia, mínimo 32 caracteres
# CORS_ORIGIN=               # origem HTTPS do frontend no navegador
# TRUST_PROXY_HOPS=          # inteiro >= 0; definir só após validar hops no Railway
# PERF_LOGGING=              # true ativa logs [PERF] de /auth/me e /me/dashboard; omitir ou false desliga
# Pool PostgreSQL (valores no código, não por env): max=10, min=3 (0 em teste), idleTimeout=60s
# acima do mínimo, connectionTimeout=10s, keepAlive. connect-pg-simple usa o mesmo pool.
# ALLOW_PRODUCTION_MIGRATIONS=true
#
# Bootstrap one-time (npm run db:bootstrap-user). Nunca no startup da API:
# INITIAL_USER_NAME=
# INITIAL_USER_EMAIL=
# INITIAL_USER_PASSWORD=
# INITIAL_USER_RA=
# INITIAL_USER_COURSE=
